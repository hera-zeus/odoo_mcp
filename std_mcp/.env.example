# Odoo Configuration
ODOO_URL=https://odoo.st-digital.com
ODOO_DB=st_digital_prod
# Compte admin dédié au serveur MCP (accès lecture globale)
ODOO_ADMIN_LOGIN=api_mcp@st-digital.com
ODOO_ADMIN_KEY=your_odoo_api_key

# LLM APIs (via LiteLLM)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# Application
API_KEY=your_secure_api_key_here
HOST=127.0.0.1
PORT=8000
ENV=production

# Default LLM
DEFAULT_LLM=anthropic/claude-sonnet-4-20250514
